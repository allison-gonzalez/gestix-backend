<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="800dp"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra de Estado superior -->
        <View
            android:id="@+id/card_status_bar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@color/status_open" />

        <TextView
            android:id="@+id/card_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABIERTO"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_gravity="start"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-26dp" />

        <!-- Contenido del Ticket -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/card_image"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="@color/primary_navy"
                android:alpha="0.2"
                android:contentDescription="Icono" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="24dp">

                <TextView
                    android:id="@+id/card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/card_priority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prioridad: Alta"
                    android:textColor="#777777"
                    android:textSize="16sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
